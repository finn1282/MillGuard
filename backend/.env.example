# Copy to backend/.env (gitignored) and fill in. Never commit the real token.
TELEGRAM_BOT_TOKEN=
# Optional: comma-separated chat ids allowed to subscribe (empty = anyone who sends /start)
TELEGRAM_ALLOWED_CHATS=
# API key for the AI advice provider (Grafilab, OpenAI-compatible); empty = advice shows "unavailable"
LLM_API_KEY=
# Base URL of the OpenAI-compatible endpoint
LLM_BASE_URL=https://llm.grafilab.ai/v1
# Model name sent to the provider
LLM_MODEL=gemini/gemini-3-flash
